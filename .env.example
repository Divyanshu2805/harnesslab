# HarnessLab environment. Copy to `.env` and fill in. Never commit `.env`.
#
# Every key below is for a FREE tier. See docs/PROVIDERS.md for the live quota
# of each, with fetch dates -- they change often, and Day 1 of the project is
# spent re-verifying them.

# --- Lane B: free-tier APIs -------------------------------------------------

# Groq. Model strings: groq/llama-3.1-8b-instant, groq/llama-3.3-70b-versatile
# Note the 70B model is 100K tokens/day, which is ~6 trajectories. It is on the
# board for the model-size axis at low N, not as a workhorse.
GROQ_API_KEY=

# Google AI Studio. Model strings: google/gemini-2.5-flash-lite, google/gemini-2.5-flash
# Flash-Lite is the Lane B workhorse: 1,000 RPD and a 250K TPM ceiling.
GOOGLE_API_KEY=

# Cerebras. No native Inspect provider -- reached through the OpenAI-compatible
# path as openai-api/cerebras/<model>, which requires BOTH vars below.
# Free tier caps context at 8,192 tokens; this is what forces the shared
# context policy across the pooled grid (see docs/adr/0008).
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# OpenRouter. Model strings: openrouter/<vendor>/<model>:free
# 50 requests/day without purchased credits -- a breadth garnish, not a workhorse.
OPENROUTER_API_KEY=

# Mistral. Model strings: mistral/<model>
MISTRAL_API_KEY=

# --- Lane A: consumer hardware ----------------------------------------------

# Ollama on the local RTX 4060. No key needed; only the endpoint.
# Model strings: ollama/<model>. Pin DIGESTS, not tags -- tags move, and a
# result that cannot be reproduced in six months is not a result.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Results store ----------------------------------------------------------

# Postgres (Neon/Supabase free tier) is the source of truth.
# Free tiers idle-suspend; the client retries on connect. Leave blank to fall
# back to the local SQLite backend, which is what CI uses on fork PRs.
HARNESSLAB_DATABASE_URL=

# --- Run configuration ------------------------------------------------------

# Where Inspect writes .eval logs before they are ingested.
INSPECT_LOG_DIR=./logs

# Guard rail. The admission controller refuses to start a shard it cannot
# finish inside the remaining daily quota; set to 0 to disable (not advised).
HARNESSLAB_ENFORCE_BUDGET=1
